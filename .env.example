# ── 로컬 개발 ────────────────────────────────────────────────
# docker compose -f docker-compose.dev.yml up -d  로 DB를 띄운 뒤 아래를 그대로 쓴다.
DB_URL=jdbc:postgresql://localhost:5432/tourlab
DB_USERNAME=tourlab
DB_PASSWORD=tourlab

# ── 운영(EC2) ───────────────────────────────────────────────
# DB는 별도 인스턴스에서 돈다. 퍼블릭 IP가 아니라 같은 VPC의 "사설 IP"를 쓴다.
# DB 인스턴스는 외부에 포트를 열지 않고, 5432만 이 서버의 보안 그룹에서 허용한다.
#   DB_URL=jdbc:postgresql://10.0.x.x:5432/tourlab

# 최소 32바이트.  openssl rand -base64 48
JWT_SECRET=

# 쉼표 구분. * 를 쓸 수 있다.
#   예) http://localhost:5173,https://tour-navigator.vercel.app
# Vercel 미리보기는 PR마다 주소가 바뀌므로 패턴으로 받는다. 이때 프로젝트 이름까지 붙여
# 좁히고, https://*.vercel.app 처럼 전체를 열지 않는다(남의 Vercel 앱도 호출하게 된다).
#   예) https://tour-navigator-*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
