# 로컬 개발: docker-compose.dev.yml 로 DB를 띄운 뒤 아래 값을 그대로 쓰면 된다.
DB_URL=jdbc:postgresql://localhost:5432/tourlab
DB_USERNAME=tourlab
DB_PASSWORD=tourlab

# 최소 32바이트. openssl rand -base64 48 로 생성
JWT_SECRET=

# 쉼표 구분. 예) http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
